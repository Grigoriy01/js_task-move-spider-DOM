"use strict";
document.addEventListener("click", function(e) {
    // write code here
    var wall = document.querySelector(".wall");
    var spider = document.querySelector(".spider");
    var leftBorderWall = wall.getBoundingClientRect().left + wall.clientLeft;
    var topBorderWall = wall.getBoundingClientRect().top + wall.clientTop;
    var currClick = e.target.closest(".wall");
    if (!currClick) return;
    var currClickPosX = e.clientX;
    var currClickPosY = e.clientY;
    var SpiderWidth = spider.offsetWidth;
    var SpiderHeight = spider.offsetHeight;
    // start & end the borders of Wall
    var startW = leftBorderWall; // + SpiderWidth / 2;
    var endW = leftBorderWall + wall.clientWidth;
    var startH = topBorderWall + SpiderHeight / 2;
    var endH = topBorderWall + wall.clientHeight;
    if (currClickPosX < startW + SpiderWidth / 2) spider.style.left = "0px";
    else if (currClickPosX > endW - SpiderWidth / 2) spider.style.left = "".concat(wall.clientWidth - SpiderWidth, "px");
    else spider.style.left = "".concat(currClickPosX - leftBorderWall - SpiderWidth / 2, "px");
    if (currClickPosY < startH + SpiderWidth / 2) spider.style.top = "0px";
    else if (currClickPosY > endH - SpiderWidth / 2) spider.style.top = "".concat(wall.clientHeight - SpiderHeight, "px");
    else spider.style.top = "".concat(currClickPosY - topBorderWall - SpiderHeight / 2, "px");
});

